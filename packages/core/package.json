{
  "name": "akso-ui",
  "version": "0.1.0",
  "description": "Accessible color tokens, React utilities (VisuallyHidden, LiveRegion, SkipLink) and test helpers from Akso UI.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "react",
    "design-tokens",
    "contrast",
    "screen-reader",
    "axe",
    "base-ui",
    "shadcn"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jfpanchi/akso-ui/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/jfpanchi/akso-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jfpanchi/akso-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens.css",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "generate:css": "node scripts/generate-tokens-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@testing-library/user-event": ">=14",
    "axe-core": ">=4.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest-axe": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/user-event": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "vitest-axe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vitest-axe": "^0.1.0"
  }
}

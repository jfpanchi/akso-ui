{
  "name": "akso-ui-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter akso-ui build",
    "lint": "eslint .",
    "typecheck": "pnpm build:core && pnpm -r typecheck",
    "test": "pnpm build:core && pnpm -r test",
    "test:e2e": "pnpm --filter www build && pnpm --filter www test:e2e:chromium",
    "registry:build": "pnpm --filter www registry:build",
    "verify:registry": "scripts/verify-registry.sh",
    "changeset": "changeset",
    "new:component": "node scripts/new-component.ts",
    "test:e2e:all": "pnpm --filter www build && pnpm --filter www test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "type": "module"
}
